# ==========================================
# SehatSaathi Environment Configuration
# ==========================================

# Optional: Google Gemini API key for enhanced generative explanations
# If left empty, SehatSaathi operates in 100% deterministic, grounded RAG mode
# using the curated ICMR / WHO / MoHFW knowledge base.
GEMINI_API_KEY=

# Optional: MongoDB connection string for external persistent clustering
# If not provided, SehatSaathi utilizes its built-in in-memory / local storage engine.
MONGODB_URI=

# Next.js Port
PORT=3000

# Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
